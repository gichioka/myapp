# Git 関連
.git
.github

# 依存パッケージ・一時ログ
node_modules
vendor
npm-debug.log
yarn-error.log

# Laravel キャッシュ・ログ・セッション（コンテナ内ビルドで再構築するため除外）
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
bootstrap/cache/*.php

# 環境設定ファイル（コンテナ外の機密値混入を防止）
.env
.env.*
!.env.example

# フロントエンド成果物（Dockerfile 内の Stage 1 でビルドするためホスト側は除外）
public/build
public/hot
public/storage

# 秘密鍵・認証・テストキャッシュ
storage/*.key
storage/pail
auth.json
.phpunit.cache
.phpunit.result.cache

# 開発環境・エディタ固有設定
Homestead.json
Homestead.yaml
.phpactor.json
.fleet
.idea
.nova
.vscode
.zed

# Docker 関連ファイル自体の再帰除外
Dockerfile
docker-compose*.yml
.dockerignore