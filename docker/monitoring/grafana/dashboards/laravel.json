{
  "id": null,
  "uid": "laravel-monitoring",
  "title": "Laravel OpenTelemetry Monitoring",
  "tags": [
    "laravel",
    "otel",
    "grafana"
  ],
  "timezone": "browser",

  "schemaVersion": 39,

  "version": 1,

  "refresh": "10s",

  "time": {
    "from": "now-1h",
    "to": "now"
  },


  "panels": [

    {
      "id": 1,

      "title": "OTel Collector Received Spans",

      "type": "stat",

      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },

      "targets": [
        {
          "expr": "otelcol_receiver_accepted_spans",
          "legendFormat": "spans"
        }
      ],

      "gridPos": {
        "x":0,
        "y":0,
        "w":6,
        "h":4
      }
    },


    {
      "id": 2,

      "title": "OTel Collector Metrics",

      "type": "timeseries",

      "datasource": {
        "type": "prometheus",
        "uid": "Prometheus"
      },

      "targets": [
        {
          "expr": "rate(otelcol_exporter_sent_metric_points[5m])",

          "legendFormat":"metrics/sec"
        }
      ],

      "gridPos":{
        "x":6,
        "y":0,
        "w":18,
        "h":8
      }
    },


    {
      "id":3,

      "title":"Laravel Logs",

      "type":"logs",

      "datasource":{

        "type":"loki",

        "uid":"Loki"

      },


      "targets":[

        {

          "expr":
          "{service_name=\"laravel\"}"

        }

      ],

      "gridPos":{

        "x":0,

        "y":8,

        "w":24,

        "h":10

      }

    },


    {
      "id":4,

      "title":"Laravel Traces",

      "type":"traces",

      "datasource":{

        "type":"tempo",

        "uid":"Tempo"

      },


      "gridPos":{

        "x":0,

        "y":18,

        "w":24,

        "h":10

      }

    }

  ],


  "templating": {

    "list": []

  },


  "annotations": {

    "list": []

  },


  "links": []

}